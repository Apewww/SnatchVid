# ---------------------------------------------------------------------------
# SnatchVid — Environment Configuration
# Salin file ini menjadi .env untuk mengaktifkan konfigurasi custom
# ---------------------------------------------------------------------------

# Server Settings
PORT=8000
HOST=0.0.0.0

# Rate Limiting (Proteksi deployment produksi per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
